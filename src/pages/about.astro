---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");
if (!about) {
  throw new Error("Missing about page: src/content/pages/about.md");
}
const { Content } = await render(about);
const { title, description, ogImage, canonicalURL } = about.data;
---

<Layout
  title={`${title} | ${config.site.title}`}
  {description}
  {ogImage}
  {canonicalURL}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={title}>
    <article class="app-prose max-w-app mt-8 mb-12 w-full">
      <Content />
    </article>
  </Main>
  <Footer />
</Layout>
